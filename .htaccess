# Apache / LiteSpeed config for the Admin Portal on shared hosting (Hostinger).
#
# Same reason as the Storefront's copy: the portal uses BrowserRouter, so every path the server sees
# is a route with no file behind it. See public/.htaccess in the repo root for the full rationale.
#
# Differences from the Storefront: no apple-app-site-association (the portal is not a deep-link
# target and has no mobile app), no service worker, and it is deliberately kept out of search
# results — it is staff-only, and an indexed login page invites credential stuffing.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"

    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <Files "index.html">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.html [L]
</IfModule>
