VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Native Google Sign-In (mobile). Three OAuth clients live in one Google Cloud project:
# web (also used to verify Android), Android (needs the release keystore SHA-1), iOS (bundle ID).
# All of them must be listed as allowed audiences on Supabase's Google provider.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# Deep-link verification files, generated into dist/.well-known/ at build time.
# APPLE_TEAM_ID: Apple Developer > Membership. ANDROID_CERT_SHA256: keytool -list -v on the release keystore.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
