<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links. Verified by Apple against
	     https://beauty.tips-sd.com/.well-known/apple-app-site-association (see docs/MOBILE.md).
	     The capability must also be enabled on the App ID in the Apple Developer portal. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:beauty.tips-sd.com</string>
	</array>
</dict>
</plist>
